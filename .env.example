# ===================================================
# Server & Environment Configuration
# ===================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===================================================
# MySQL Database Configuration
# ===================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mediminder_db

# Optional fallback flag: if MySQL is offline or not installed,
# setting USE_SQLITE_FALLBACK=true allows zero-config local testing
# using a local sqlite file with the identical schema and API.
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/mediminder.sqlite

# ===================================================
# JWT Authentication
# ===================================================
JWT_SECRET=mediminder_super_secure_jwt_secret_key_2026_xyz!
JWT_EXPIRES_IN=7d

# ===================================================
# Background Reminder Scheduler
# ===================================================
# Cron expression for checking & generating due reminders (every minute default)
REMINDER_CRON_SCHEDULE=* * * * *

# ===================================================
# Optional Email Notification Service (SMTP)
# ===================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="MediMinder Alerts <no-reply@mediminder.app>"
